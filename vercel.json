{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "remix",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://cryzo-v5-auth-20260421.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://cryzo-v5-auth-20260421.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
